# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
#   cp .env.example .env
#   docker compose up

# ---------------------------------------------------------------------------
# Model provider. Swapping provider is a change to these variables only -
# there is no code path that names a vendor.
#
#   RAG_CHAT_PROVIDER      openai | mistral | google-genai | anthropic | ollama | none
#   RAG_EMBEDDING_PROVIDER openai | mistral | ollama | none
#
# Note: Anthropic has no embedding model, so chat=anthropic is normally paired
# with embedding=openai, and both keys are then required.
# ---------------------------------------------------------------------------
RAG_CHAT_PROVIDER=openai
RAG_EMBEDDING_PROVIDER=openai

# Required when the corresponding provider is selected.
OPENAI_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- FREE OPTIONS (no credit card) ------------------------------------------
#
# 1. Mistral - simplest. One free key covers BOTH chat and embeddings.
#    Key: https://console.mistral.ai/api-keys
#
#      RAG_CHAT_PROVIDER=mistral
#      RAG_EMBEDDING_PROVIDER=mistral
#      RAG_CHAT_MODEL=mistral-small-latest
#      RAG_EMBEDDING_MODEL=mistral-embed
#      RAG_EMBEDDING_DIMENSIONS=1024      <-- mistral-embed is 1024, not 1536
#      MISTRAL_API_KEY=<your key>
#
#    Changing the dimension needs a rebuilt database:
#      docker compose down -v && docker compose up
#    The app refuses to start otherwise, rather than mixing embedding spaces.
#
# 2. Google Gemini - free chat only. Key: https://aistudio.google.com/apikey
#    Spring AI 2.0's Google embedding module is Vertex AI based and needs a GCP
#    project with billing, so it is NOT usable on the free AI Studio key. Pair
#    Gemini chat with Mistral or Ollama embeddings:
#
#      RAG_CHAT_PROVIDER=google-genai
#      RAG_CHAT_MODEL=gemini-2.5-flash
#      GOOGLE_API_KEY=<your key>
#      RAG_EMBEDDING_PROVIDER=mistral
#      RAG_EMBEDDING_MODEL=mistral-embed
#      RAG_EMBEDDING_DIMENSIONS=1024
#      MISTRAL_API_KEY=<your key>
#
# 3. Ollama - fully local, no key, no network. Needs ~2.3GB of model download:
#      ollama pull nomic-embed-text && ollama pull llama3.2:3b
#
#      RAG_CHAT_PROVIDER=ollama
#      RAG_EMBEDDING_PROVIDER=ollama
#      RAG_CHAT_MODEL=llama3.2:3b
#      RAG_EMBEDDING_MODEL=nomic-embed-text
#      RAG_EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Models. Changing the embedding model usually changes its dimension, and the
# pgvector column type is fixed at migration time - so RAG_EMBEDDING_DIMENSIONS
# must match, and an existing database must be re-migrated and re-ingested.
# The app refuses to start if these disagree.
#
#   text-embedding-3-small -> 1536   (OpenAI, default)
#   text-embedding-3-large -> 3072   (OpenAI)
#   nomic-embed-text       -> 768    (Ollama, local)
# ---------------------------------------------------------------------------
RAG_CHAT_MODEL=gpt-4.1-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536

# For a fully local setup with Ollama running on the host:
#   RAG_CHAT_PROVIDER=ollama
#   RAG_EMBEDDING_PROVIDER=ollama
#   RAG_CHAT_MODEL=llama3.1
#   RAG_EMBEDDING_MODEL=nomic-embed-text
#   RAG_EMBEDDING_DIMENSIONS=768
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# Retrieval. See README "Similarity threshold" for how 0.62 was chosen.
# ---------------------------------------------------------------------------
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.62

# ---------------------------------------------------------------------------
# Chunking. Sizes are in BPE tokens. See README "Chunking strategy".
# ---------------------------------------------------------------------------
RAG_CHUNK_MAX_TOKENS=450
RAG_CHUNK_OVERLAP_TOKENS=80

# ---------------------------------------------------------------------------
# Database. Defaults work with docker compose; override for an external DB.
# ---------------------------------------------------------------------------
DB_NAME=docqa
DB_USERNAME=docqa
DB_PASSWORD=docqa
DB_PORT=5432

SERVER_PORT=8080
LOG_LEVEL=INFO
